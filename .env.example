# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
API_KEY=your-secret-api-key-here     # X-API-Key header value for auth

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver format: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/deep_research

# ── LLM Providers ─────────────────────────────────────────────────────────────
# At least one must be set. ACTIVE_LLM_PROVIDER controls which is used.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ACTIVE_LLM_PROVIDER=openai           # openai | anthropic | ollama

# ── Ollama (free, local — no API key needed) ───────────────────────────────────
# Install: https://ollama.com  then: ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model: 1536 for OpenAI, 768 for nomic-embed-text
EMBEDDING_DIMENSIONS=1536

# ── Search ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...              # Primary search provider
# DuckDuckGo requires no key — used automatically as fallback

# ── Research Defaults ─────────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=10               # 429 returned if exceeded
CHUNK_SIZE_TOKENS=512                # Tokens per content chunk before embedding
CHUNK_OVERLAP_TOKENS=50             # Overlap between consecutive chunks
DEDUP_SIMILARITY_THRESHOLD=0.85     # Cosine similarity threshold for deduplication
